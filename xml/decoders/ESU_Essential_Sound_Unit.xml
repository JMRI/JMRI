                    <label xml:lang="de">Sound|slot 5</label>
                </output>
                <output name="14" label="Sound|slot 6">
                    <label xml:lang="fr">Créneau|Son 6</label>
                    <label xml:lang="it">Slot| Suono 6</label>
                    <label xml:lang="de">Sound|slot 6</label>
