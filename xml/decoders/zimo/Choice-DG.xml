<!-- version 1 - for Unified Software V36+, Intended for Swiss Mapping Dimming Group Menus Nigel Cliffe 13Feb2021 -->
<!-- version 2 - Pierre Billon - 2026-07-29 - added the value 6, "Off".                     -->
<!--   ZIMO declare this field as "Bits 7, 6, 5 (7 possible values or zero)", so 0 to 7, but   -->
<!--   name only five dimming CVs (#508 to #512), which is why this list stopped at 5 and a    -->
<!--   decoder returning 6 showed as "Reserved value 6". ZIMO's own configuration software     -->
<!--   offers "off" in this selector and writes 6, confirmed on an MS decoder. Note this is    -->
<!--   distinct from 0: 0 means no dimming, 6 turns the output off. The variables using this  -->
<!--   list carry a tooltip spelling that out; the choice itself is kept short because it     -->
<!--   appears in every cell of the Swiss Mapping grid.                                       -->
<!--   UNTESTED ON THE MX SOUND DECODERS - this file is shared with them through               -->
<!--   CVSwissMapping_v36.xml and CVSwissMapping_v40.xml. The field is documented the same     -->
<!--   way there, so the value should behave identically, but it has not been verified on MX   -->
<!--   hardware. Value 7 is left undefined: the range allows it, nothing documents it.         -->
<enumChoiceGroup xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://jmri.org/xml/schema/decoder-4-15-2.xsd">
      <enumChoice choice="None">
        <choice>None</choice>
        <choice xml:lang="it">Nessuna</choice>
        <choice xml:lang="de">keine</choice>
        <choice xml:lang="cs">Žádný</choice>
      </enumChoice>
      <enumChoice choice="1">
        <choice>1</choice>
     </enumChoice>
      <enumChoice choice="2">
        <choice>2</choice>
      </enumChoice>
      <enumChoice choice="3">
        <choice>3</choice>
      </enumChoice>
      <enumChoice choice="4">
        <choice>4</choice>
      </enumChoice>
      <enumChoice choice="5">
        <choice>5</choice>
      </enumChoice>
      <enumChoice choice="Off" value="6">
        <choice>Off</choice>
        <choice xml:lang="fr">Off</choice>
        <choice xml:lang="de">Off</choice>
      </enumChoice>
</enumChoiceGroup>
