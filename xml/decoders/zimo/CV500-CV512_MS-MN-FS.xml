    </enumVal>
    <label>Hibeam</label>
    <label xml:lang="cs">Dálkové světlo</label>
    <label xml:lang="fr">Feux de route</label>
    <label xml:lang="de">Fernlicht</label>
    <tooltip>M-key Hibeam (hides other options in CV503 )</tooltip>
