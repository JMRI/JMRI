				<label>A2 time value (CV 129)</label>
				<label xml:lang="de">A2 Zeitwert für Sonderfunktion (CV 129)</label>
			</variable>
			<variable mask="XXVXXXXX" item="A2 Fading" CV="49" default="0">
				<enumVal>
					<enumChoice value="0"><choice>Off</choice><choice xml:lang="de">Aus</choice></enumChoice>
					<enumChoice value="1"><choice>On</choice><choice xml:lang="de">Ein</choice></enumChoice>
				</enumVal>
				<label>A2 fade in/out (CV49, from V1.4)</label>
				<label xml:lang="de">A2 auf-/abdimmen (CV49, ab V1.4)</label>
			</variable>
			<variable mask="VXXXXXXX" item="A2 Inverse" CV="49" default="0">
				<enumVal>
					<enumChoice value="0"><choice>Off</choice><choice xml:lang="de">Aus</choice></enumChoice>
					<enumChoice value="1"><choice>On</choice><choice xml:lang="de">Ein</choice></enumChoice>
				</enumVal>
				<label>A2 inverse (CV49, from V1.1)</label>
				<label xml:lang="de">A2 invers (CV49, ab V1.1)</label>
			</variable>
			<variable mask="XXXXXXVX" item="A2 Analog" CV="13" default="1">
				<enumVal>
					<enumChoice value="0"><choice>Off</choice><choice xml:lang="de">Aus</choice></enumChoice>
					<enumChoice value="1"><choice>On</choice><choice xml:lang="de">Ein</choice></enumChoice>
