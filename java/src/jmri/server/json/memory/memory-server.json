{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "jmri-json-memory-server-message",
    "type": "object",
    "description": "Data portion of message from JMRI to client for type \"memory\"",
    "properties": {
        "name": {
            "type": "string",
            "description": "System name of the memory"
        },
        "userName": {
            "type": [
                "string",
                "null"
            ],
            "description": "User name of the memory"
        },
        "comment": {
            "type": [
                "string",
                "null"
            ],
            "description": "Comment for the memory"
        },
        "properties": {
            "type": "array",
            "description": "NamedBean properties of the memory; each item has a single key, the property name, with the value as a string or null",
            "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "value": {
            "type": [
                "string",
                "object",
                "null"
            ],
            "description": "The memory's value: text, or an object if the value is an idTag, reporter or roster entry"
        }
    },
    "additionalProperties": false,
    "required": [
        "name",
        "userName",
        "comment",
        "value"
    ]
}