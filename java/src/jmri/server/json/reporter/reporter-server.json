{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "jmri-json-reporter-server-message",
    "type": "object",
    "description": "Data portion of message from JMRI to client for type \"reporter\"",
    "properties": {
        "name": {
            "type": "string",
            "description": "System name of the reporter"
        },
        "userName": {
            "type": [
                "string",
                "null"
            ],
            "description": "User name of the reporter"
        },
        "comment": {
            "type": [
                "string",
                "null"
            ],
            "description": "Comment for the reporter"
        },
        "properties": {
            "type": "array",
            "description": "NamedBean properties of the reporter; each item has a single key, the property name, with the value as a string or null",
            "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "state": {
            "type": "integer",
            "description": "The state of the reporter; what it means depends on the hardware (a LocoNet transponding reporter uses the loco address, for example)"
        },
        "report": {
            "type": [
                "string",
                "null"
            ],
            "description": "The current reported value as a string"
        },
        "lastReport": {
            "type": [
                "string",
                "null"
            ],
            "description": "The last reported value as a string"
        },
        "value": {
            "type": [
                "string"
            ],
            "description": "The current reported value or <no report> or <blank>"
        }
    },
    "additionalProperties": false,
    "required": [
        "name",
        "userName",
        "comment",
        "state",
        "report",
        "lastReport",
        "value"
    ]
}