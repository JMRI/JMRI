{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "jmri-json-oblock-server-message",
    "type": "object",
    "description": "Data portion of message from JMRI to client for type \"oblock\"",
    "properties": {
        "name": {
            "type": "string",
            "description": "System name of the OBlock"
        },
        "userName": {
            "type": [
                "string",
                "null"
            ],
            "description": "User name of the OBlock"
        },
        "comment": {
            "type": [
                "string",
                "null"
            ],
            "description": "Comment for the OBlock"
        },
        "properties": {
            "type": "array",
            "description": "NamedBean properties of the OBlock; each item has a single key, the property name, with the value as a string or null",
            "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "status": {
            "type": "integer",
            "minimum": 0,
            "description": "The status of the OBlock, a sum of flags: 2 occupied, 4 unoccupied, 16 allocated to a warrant, 32 a running train has reached it, 64 out of service, 128 track error, 256 dark (no detector); 0 if unknown. A dark block with no other flags is sent as 0"
        },
        "sensor": {
            "type": [
                "string",
                "null"
            ],
            "description": "The system name of the sensor associated with the OBlock"
        },
        "warrant": {
            "type": [
                "string",
                "null"
            ],
            "description": "Allocated warrant for the OBlock"
        },
        "train": {
            "type": [
                "string",
                "null"
            ],
            "description": "Train in Warrant for the OBlock"
        }
    },
    "additionalProperties": false,
    "required": [
        "name",
        "userName",
        "comment",
        "status",
        "properties",
        "sensor",
        "warrant",
        "train"
    ]
}