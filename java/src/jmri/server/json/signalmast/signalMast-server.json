{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "jmri-json-signalMast-server-message",
    "type": "object",
    "description": "Data portion of message from JMRI to client for type \"signalMast\"",
    "properties": {
        "name": {
            "type": "string",
            "description": "System name of the signalMast"
        },
        "userName": {
            "type": [
                "string",
                "null"
            ],
            "description": "User name of the signalMast"
        },
        "comment": {
            "type": [
                "string",
                "null"
            ],
            "description": "Comment for the signalMast"
        },
        "properties": {
            "type": "array",
            "description": "NamedBean properties of the signalMast; each item has a single key, the property name, with the value as a string or null",
            "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "aspect": {
            "type": "string",
            "description": "The current signalMast aspect"
        },
        "lit": {
            "type": "boolean",
            "description": "true if lit, false otherwise"
        },
        "held": {
            "type": "boolean",
            "description": "true if held, false otherwise"
        },
        "state": {
            "type": "string",
            "description": "The current aspect, or \"Dark\" if not lit, or \"Held\" if held (when the mast has those appearances)"
        }
    },
    "additionalProperties": false,
    "required": [
        "name",
        "userName",
        "comment",
        "aspect",
        "lit",
        "held",
        "state"
    ]
}