{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "jmri-json-signalHead-server-message",
    "type": "object",
    "description": "Data portion of message from JMRI to client for type \"signalHead\"",
    "properties": {
        "name": {
            "type": "string",
            "description": "System name of the signalHead"
        },
        "userName": {
            "type": [
                "string",
                "null"
            ],
            "description": "User name of the signalHead"
        },
        "comment": {
            "type": [
                "string",
                "null"
            ],
            "description": "Comment for the signalHead"
        },
        "properties": {
            "type": "array",
            "description": "NamedBean properties of the signalHead; each item has a single key, the property name, with the value as a string or null",
            "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "lit": {
            "type": "boolean",
            "description": "true if lit, false otherwise"
        },
        "held": {
            "type": "boolean",
            "description": "true if held, false otherwise"
        },
        "state": {
            "type": "integer",
            "description": "The current appearance, or 256 if held"
        },
        "appearance": {
            "type": "integer",
            "description": "The current appearance"
        },
        "appearanceName": {
            "type": "string",
            "description": "The name of the current appearance"
        }
    },
    "additionalProperties": false,
    "required": [
        "name",
        "userName",
        "comment",
        "lit",
        "held",
        "state",
        "appearance",
        "appearanceName"
    ]
}