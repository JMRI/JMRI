{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "jmri-json-audio-server-message",
    "type": "object",
    "description": "Data portion of message from JMRI to client for type \"audio\"",
    "properties": {
        "name": {
            "type": "string",
            "description": "System name of the audio"
        },
        "userName": {
            "type": [
                "string",
                "null"
            ],
            "description": "User name of the audio"
        },
        "comment": {
            "type": [
                "string",
                "null"
            ],
            "description": "Comment for the audio"
        },
        "properties": {
            "type": "array",
            "description": "NamedBean properties of the audio; each item has a single key, the property name, with the value as a string or null",
            "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "state": {
            "type": "integer",
            "description": "The state of the audio",
            "enum": [
                0,
                2,
                4,
                8
            ]
        }
    },
    "additionalProperties": false,
    "required": [
        "name",
        "userName",
        "comment",
        "inverted",
        "state"
    ]
}